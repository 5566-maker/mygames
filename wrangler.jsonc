{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kids-arcade",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "game.yuewang.eu.cc",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
